# ==============================
# CONFIGURACIÓN GENERAL
# ==============================

FLASK_APP=run.py
FLASK_ENV=development

SECRET_KEY=tu-clave-secreta-muy-larga-cambiar
DATABASE_URL=sqlite:///medicerca.db


